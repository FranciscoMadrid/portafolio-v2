---
import Image from "astro/components/Image.astro";
import LogoEntry from '../animations/LogoEntry'
---
<section class='min-h-screen max-w-7xl mx-auto relative flex flex-col overflow-hidden'>
  <div class="absolute w-[50vw] h-[50vh] top-1/2 items-center justify-center flex right-1/2 translate-x-1/2 -translate-y-1/2">
    <LogoEntry
      xDistance="-200px"
      yDistance="100px"
      client:load>
      <Image 
        width={180} 
        height={150}
        alt="leftside.png"
        src={'/images/hero/Left Side.png'}
      />
    </LogoEntry>
    <LogoEntry
      xDistance="200px"
      yDistance="-100px"
      client:load>
      <Image 
        width={180} 
        height={150}
        alt="leftside.png"
        src={'/images/hero/Right Side.png'}
      />
    </LogoEntry>
  </div>
  {/* Fullstack Dev Text */}
  <div class=' absolute left-0 top-0 p-5'>
    <div class='grid grid-cols-3 font-bold'>
      <span class='text-7xl text-primary-darker col-span-full'>
        Fullstack Dev
      </span>
      <span class='text-3xl text-primary-main col-span-2'>
        Turning ideas,
      </span>
      <div class='flex flex-wrap items-center col-span-full gap-2'>
        <span class='text-3xl text-primary-main'>
          into
        </span>
        <span class='text-6xl text-primary-dark row-span-2'>
          TOOLS
        </span>
      </div>
    </div>
  </div>
  {/* Data Analyst Text */}
  <div class='absolute right-0 bottom-0 p-5 '>
    <div class='flex flex-col font-bold '>
      <span class='text-3xl text-secondary-main'>
        Crafting stories,
      </span>
      <div class='flex flex-wrap items-center gap-2'>
        <span class='text-3xl text-secondary-main'>
          for a new
        </span>
        <span class='text-6xl text-secondary-dark row-span-2'>
          PERSPECTIVE
        </span>
      </div>
      <span class='text-7xl text-secondary-darker col-span-full'>
        Data Analyst
      </span>
    </div>
  </div>
</section>